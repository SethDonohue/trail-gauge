{
  "expo": {
    "name": "TrailGauge",
    "slug": "trailgauge",
    "version": "0.4.0",
    "orientation": "default",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0b0d0e",
    "newArchEnabled": true,
    "android": {
      "package": "com.trailgauge.app",
      "versionCode": 1,
      "permissions": [
        "android.permission.BLUETOOTH_SCAN",
        "android.permission.BLUETOOTH_CONNECT",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.WAKE_LOCK",
        "android.permission.VIBRATE"
      ],
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-foreground.png",
        "monochromeImage": "./assets/adaptive-monochrome.png",
        "backgroundColor": "#0b0d0e"
      },
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "react-native-ble-plx",
        {
          "isBackgroundEnabled": false,
          "modes": [],
          "neverForLocation": true,
          "bluetoothAlwaysPermission": "TrailGauge connects to your TrailGauge hub over Bluetooth to show vehicle temperatures and battery voltage."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "TrailGauge uses your location for speed, magnetic declination and altitude calibration."
        }
      ],
      [
        "expo-sensors",
        {
          "motionPermission": "TrailGauge uses motion sensors and the barometer to show tilt, heading and altitude."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false
        }
      ]
    ],
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "com.sethdonohue.trailgauge",
      "buildNumber": "1",
      "supportsTablet": true,
      "requireFullScreen": false,
      "infoPlist": {
        "UIStatusBarHidden": true,
        "UIViewControllerBasedStatusBarAppearance": false,
        "ITSAppUsesNonExemptEncryption": false
      }
    }
  }
}
